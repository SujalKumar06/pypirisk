# Copy to .env (git-ignored) and fill in. Never commit the real file.

# Grafana admin login (user: admin)
GRAFANA_ADMIN_PASSWORD=change-me

# Credentials for the SeaweedFS S3 store that backs the DVC remote
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me

# Host user, so files the pipeline container writes into the repo stay yours
UID=1000
GID=1000

# Image tag for docker compose build/push
IMAGE_TAG=latest

# Phase 1: GitHub token for the GraphQL crawler (read-only public repo scope)
GITHUB_TOKEN=
